// Ресурсы теста gui_dialog.c
#include <windows.h>
#define IDC_EDIT 101
#define IDC_CHECK 102
#define IDC_RADIO1 103
#define IDC_RADIO2 104
#define IDC_LIST 105
#define IDC_COMBO 106
#define IDC_LABEL 107
#define IDC_PIC 108

1 ICON "gui_test.ico"
2 BITMAP "gui_test.bmp"

10 DIALOGEX 0, 0, 200, 150
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog test"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Name:", IDC_LABEL, 7, 9, 30, 8
    EDITTEXT        IDC_EDIT, 40, 7, 100, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Check me", IDC_CHECK, 7, 28, 80, 10
    AUTORADIOBUTTON "Radio &1", IDC_RADIO1, 7, 42, 60, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Radio &2", IDC_RADIO2, 70, 42, 60, 10
    LISTBOX         IDC_LIST, 7, 58, 90, 50, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    COMBOBOX        IDC_COMBO, 105, 58, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    ICON            1, IDC_PIC, 160, 7, 16, 16
    DEFPUSHBUTTON   "OK", IDOK, 89, 129, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 143, 129, 50, 14
END

20 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", 1001
        MENUITEM SEPARATOR
        MENUITEM "E&xit", 1002, GRAYED
    END
END

30 ACCELERATORS
BEGIN
    "O", 1001, VIRTKEY, CONTROL
END

STRINGTABLE
BEGIN
    40 "Hello from a string table"
END
