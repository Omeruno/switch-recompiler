+    void litehtml::html_tag::reset_native_styles()
+    {
+        std::sort(m_pseudo_classes.begin(), m_pseudo_classes.end());
+        m_pseudo_classes.erase(std::unique(m_pseudo_classes.begin(), m_pseudo_classes.end()), m_pseudo_classes.end());
+        m_style.clear();
+        m_used_styles.clear();
+        for(auto it = m_children.begin(); it != m_children.end();)
+        {
+            if((*it)->tag() == __tag_before_ || (*it)->tag() == __tag_after_)
+            {
+                (*it)->parent(nullptr);
+                it = m_children.erase(it);
+            }
+            else
+            {
+                if(auto child = std::dynamic_pointer_cast<html_tag>(*it))
+                    child->reset_native_styles();
+                ++it;
+            }
+        }
+    }
