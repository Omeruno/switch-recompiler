(module
 (import "env" "memory" (memory 1 4))
 (import "env" "counter" (global $counter (mut i32)))
 (import "env" "wide" (global $wide (mut i64)))
 (import "env" "notify" (func $notify))
 (export "memory" (memory 0))
 (export "counter" (global $counter))
 (export "wide" (global $wide))
 (data (i32.const 128) "owned")
 (func (export "read") (param i32) (result i32) local.get 0 i32.load8_u)
 (func (export "write") (param i32 i32) local.get 0 local.get 1 i32.store8)
 (func (export "size") (result i32) memory.size)
 (func (export "inc") (result i32)
  global.get $counter i32.const 1 i32.add global.set $counter global.get $counter)
 (func (export "incWide") (result i64)
  global.get $wide i64.const 2 i64.add global.set $wide global.get $wide)
 (func (export "grow") (param i32) (result i32)
  local.get 0 memory.grow call $notify)
)
