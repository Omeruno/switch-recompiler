set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{DEVKITPRO})
  message(FATAL_ERROR "DEVKITPRO is required")
endif()
set(dkp "$ENV{DEVKITPRO}")
set(CMAKE_C_COMPILER "${dkp}/devkitA64/bin/aarch64-none-elf-gcc")
set(CMAKE_ASM_COMPILER "${dkp}/devkitA64/bin/aarch64-none-elf-gcc")
set(CMAKE_AR "${dkp}/devkitA64/bin/aarch64-none-elf-gcc-ar")
set(CMAKE_RANLIB "${dkp}/devkitA64/bin/aarch64-none-elf-gcc-ranlib")
set(CMAKE_C_FLAGS_INIT "-O2 -march=armv8-a+crc+crypto -mtune=cortex-a57 -mno-outline-atomics -mtp=soft -ftls-model=local-exec -fPIE -ffunction-sections -fdata-sections -D__SWITCH__ -isystem ${dkp}/libnx/include")
